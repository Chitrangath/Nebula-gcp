# Run from the worker directory. Never commit the real .env.
NODE_ID=registered-node-uuid
API_KEY=one-time-node-api-key
WORKER_SIGNING_PRIVATE_KEY=node-specific-worker-signer-private-key
BACKEND_URL=https://YOUR-CLOUD-RUN-SERVICE.run.app
CHAIN_ID=421614
VERIFYING_CONTRACT=0xbD0A2f65ae2C67A313d2883cAed5029A3275a599
EXECUTOR_ADAPTER=multimodel
EXECUTOR_DEVICE=cuda
BERT_VOCAB_PATH=.cache/bert/vocab.txt
MODEL_CACHE_DIR=.cache/verified-models
MODEL_DOWNLOAD_TIMEOUT_SECONDS=900
MAX_MODEL_ARTIFACT_BYTES=805306368
